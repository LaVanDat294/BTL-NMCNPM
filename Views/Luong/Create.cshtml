@model NMCNPM.Models.Luong
@{
    ViewData["Title"] = "Thêm bảng lương thủ công";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-cash me-2"></i>Thêm bảng lương thủ công</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="SMaLuong" class="form-label fw-bold">Mã Lương</label>
                                <input asp-for="SMaLuong" class="form-control" placeholder="L001..." required />
                                <span asp-validation-for="SMaLuong" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FK_sMaNV" class="form-label fw-bold">Nhân Viên</label>
                                <select asp-for="FK_sMaNV" class="form-select" asp-items="ViewBag.FK_sMaNV" required>
                                    <option value="">-- Chọn nhân viên --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DKyLuong" class="form-label fw-bold">Kỳ Lương (Tháng)</label>
                                <input asp-for="DKyLuong" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-01")" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ISoGioLam" class="form-label fw-bold">Số Giờ Làm</label>
                                <input asp-for="ISoGioLam" type="number" class="form-control" value="160" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FLuongCoBan" class="form-label fw-bold">Lương Cơ Bản</label>
                                <input asp-for="FLuongCoBan" type="number" class="form-control" value="5000000" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FThuong" class="form-label fw-bold">Thưởng</label>
                                <input asp-for="FThuong" type="number" class="form-control" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FPhat" class="form-label fw-bold">Phạt / Khấu trừ</label>
                                <input asp-for="FPhat" type="number" class="form-control" value="0" />
                            </div>
                        </div>
                        <div class="mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu thông tin</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
