@model IEnumerable<NMCNPM.Models.NhanVien>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Quản lý Nhân viên</h3>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Thêm nhân viên</a>
    </div>

    <table class="table table-bordered table-hover bg-white">
        <thead class="table-dark">
            <tr>
                <th>Mã NV</th>
                <th>Họ tên</th>
                <th>CCCD</th>
                <th>Phòng ban</th>
                <th>Chức vụ</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.SMaNV</td>
                    <td>@item.STenNV</td>
                    <td>@item.SCCCD</td>
                    <td>@(item.PhongBan?.STenPB ?? "N/A")</td>
                    <td>@(item.ChucVu?.STenCV ?? "N/A")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.SMaNV" class="btn btn-sm btn-info text-white" title="Xem chi tiết"><i class="bi bi-eye"></i> Xem</a>
                        <a asp-action="Edit" asp-route-id="@item.SMaNV" class="btn btn-sm btn-warning" title="Chỉnh sửa"><i class="bi bi-pencil"></i> Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.SMaNV" class="btn btn-sm btn-danger" title="Xóa nhân viên"><i class="bi bi-trash"></i> Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
