@model IEnumerable<NMCNPM.Models.NhanVien>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
    int stt = 1;
}

<div class="container-fluid py-3">
    <!-- TIÊU ĐỀ TRANG & NÚT THÊM MỚI -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0"><i class="bi bi-people-fill"></i> Quản lý Hồ sơ Nhân viên</h3>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Thêm nhân viên mới</a>
    </div>

    <!-- KHUNG TÌM KIẾM VÀ LỌC DỮ LIỆU ĐA TIÊU CHÍ -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-bold">
            <i class="bi bi-funnel-fill text-primary"></i> Bộ lọc & Tìm kiếm
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <!-- Ô 1: Từ khóa tìm kiếm -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Từ khóa tìm kiếm</label>
                        <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" 
                               class="form-control form-control-sm" placeholder="Mã NV, Họ tên, SĐT, Email..." />
                    </div>

                    <!-- Ô 2: Lọc Phòng ban -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Phòng ban</label>
                        <select name="maPB" asp-items="ViewBag.PhongBans" class="form-select form-select-sm">
                            <option value="">-- Tất cả phòng ban --</option>
                        </select>
                    </div>

                    <!-- Ô 3: Lọc Chức vụ -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Chức vụ</label>
                        <select name="maCV" asp-items="ViewBag.ChucVus" class="form-select form-select-sm">
                            <option value="">-- Tất cả chức vụ --</option>
                        </select>
                    </div>

                    <!-- Ô 4: Lọc Trạng thái -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Trạng thái làm việc</label>
                        <select name="trangThai" class="form-select form-select-sm">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="Đang làm việc" selected="@(Context.Request.Query["trangThai"] == "Đang làm việc")">Đang làm việc</option>
                            <option value="Đã nghỉ việc" selected="@(Context.Request.Query["trangThai"] == "Đã nghỉ việc")">Đã nghỉ việc</option>
                        </select>
                    </div>
                </div>

                <!-- Nút thao tác Tìm kiếm / Làm mới -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary px-3"><i class="bi bi-search"></i> Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-sm btn-secondary px-3"><i class="bi bi-arrow-counterclockwise"></i> Làm mới</a>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH NHÂN VIÊN -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center" style="width: 50px;">STT</th>
                            <th>Mã NV</th>
                            <th>Họ và tên</th>
                            <th>Số CCCD</th>
                            <th>Phòng ban</th>
                            <th>Chức vụ</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var tenPB = ViewBag.PhongBanDict != null && ViewBag.PhongBanDict.ContainsKey(item.FK_sMaPB ?? "") 
                                            ? ViewBag.PhongBanDict[item.FK_sMaPB] 
                                            : (item.PhongBan?.STenPB ?? item.FK_sMaPB);

                                var tenCV = ViewBag.ChucVuDict != null && ViewBag.ChucVuDict.ContainsKey(item.FK_sMaCV ?? "") 
                                            ? ViewBag.ChucVuDict[item.FK_sMaCV] 
                                            : (item.ChucVu?.STenCV ?? item.FK_sMaCV);

                                bool isWorking = string.IsNullOrEmpty(item.STrangThai) || item.STrangThai.ToLower().Contains("làm") || item.STrangThai.ToLower().Contains("lam");

                                <tr>
                                    <td class="text-center fw-bold">@(stt++)</td>
                                    <td class="fw-bold text-primary">@item.SMaNV</td>
                                    <td>@item.STenNV</td>
                                    <td>@item.SCCCD</td>
                                    <td>@tenPB</td>
                                    <td>@tenCV</td>
                                    <td class="text-center">
                                        @if (isWorking)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đang làm việc</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã nghỉ việc</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.SMaNV" class="btn btn-info text-white" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                            <a asp-action="Edit" asp-route-id="@item.SMaNV" class="btn btn-warning" title="Chỉnh sửa"><i class="bi bi-pencil"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.SMaNV" class="btn btn-danger" title="Xóa nhân viên"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                    Không tìm thấy nhân viên nào phù hợp với điều kiện lọc!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- THỐNG KÊ TỔNG SỐ BẢN GHI -->
        <div class="card-footer bg-light d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Hiển thị: <strong>@(Model?.Count() ?? 0)</strong> nhân viên</span>
        </div>
    </div>
</div>