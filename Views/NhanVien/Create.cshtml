@model NMCNPM.Models.NhanVien

@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="bi bi-person-plus-fill me-2"></i>Thêm nhân viên mới
        </h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <span class="fw-bold text-secondary">
                <i class="bi bi-info-circle me-1"></i> Thông tin nhân viên
            </span>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post" class="row g-3">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="col-md-4">
                    <label asp-for="SMaNV" class="form-label fw-semibold">Mã nhân viên (*)</label>
                    <input asp-for="SMaNV" class="form-control" placeholder="Nhập mã nhân viên..." />
                    <span asp-validation-for="SMaNV" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="STenNV" class="form-label fw-semibold">Họ và tên (*)</label>
                    <input asp-for="STenNV" class="form-control" placeholder="Nhập họ và tên..." />
                    <span asp-validation-for="STenNV" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DNgaySinh" class="form-label fw-semibold">Ngày sinh</label>
                    <input asp-for="DNgaySinh" type="date" class="form-control" />
                    <span asp-validation-for="DNgaySinh" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="SCCCD" class="form-label fw-semibold">CCCD (*)</label>
                    <input asp-for="SCCCD" class="form-control" placeholder="Nhập số CCCD..." />
                    <span asp-validation-for="SCCCD" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold d-block">Giới tính</label>
                    <div class="mt-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="SGioiTinh" id="nam" value="Nam" />
                            <label class="form-check-label" for="nam">Nam</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="SGioiTinh" id="nu" value="Nữ" />
                            <label class="form-check-label" for="nu">Nữ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="SGioiTinh" id="khac" value="Khác" />
                            <label class="form-check-label" for="khac">Khác</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label asp-for="SSDT" class="form-label fw-semibold">Số điện thoại</label>
                    <input asp-for="SSDT" class="form-control" placeholder="Nhập số điện thoại..." />
                    <span asp-validation-for="SSDT" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SEmail" class="form-label fw-semibold">Email</label>
                    <input asp-for="SEmail" class="form-control" placeholder="Nhập email..." />
                    <span asp-validation-for="SEmail" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SDiaChi" class="form-label fw-semibold">Địa chỉ</label>
                    <input asp-for="SDiaChi" class="form-control" placeholder="Nhập địa chỉ..." />
                    <span asp-validation-for="SDiaChi" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FLuongcb" class="form-label fw-semibold">Lương cơ bản (*)</label>
                    <div class="input-group">
                        <input asp-for="FLuongcb" type="number" min="0" class="form-control" placeholder="Nhập lương cơ bản..." />
                        <span class="input-group-text">VNĐ</span>
                    </div>
                    <span asp-validation-for="FLuongcb" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DNgayVaoLam" class="form-label fw-semibold">Ngày vào làm</label>
                    <input asp-for="DNgayVaoLam" type="date" class="form-control" />
                    <span asp-validation-for="DNgayVaoLam" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FK_sMaPB" class="form-label fw-semibold">Phòng ban (*)</label>
                    <select asp-for="FK_sMaPB" class="form-select" asp-items="ViewBag.PhongBans">
                        <option value="">-- Chọn phòng ban --</option>
                    </select>
                    <span asp-validation-for="FK_sMaPB" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FK_sMaCV" class="form-label fw-semibold">Chức vụ (*)</label>
                    <select asp-for="FK_sMaCV" class="form-select" asp-items="ViewBag.ChucVus">
                        <option value="">-- Chọn chức vụ --</option>
                    </select>
                    <span asp-validation-for="FK_sMaCV" class="text-danger"></span>
                </div>

                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-primary px-5 py-2 me-2">
                        <i class="bi bi-plus-circle me-1"></i> Thêm mới
                    </button>
                    <button type="reset" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
