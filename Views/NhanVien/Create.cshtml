@model NMCNPM.Models.NhanVien

@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-person-plus-fill"></i> Thêm nhân viên mới</h1>
    <a asp-action="Index" class="btn-outline-primary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card" style="padding: 25px; margin-bottom: 40px;">
    <div class="card-title" style="margin-bottom: 20px;"><i class="bi bi-person-lines-fill"></i> Thông tin nhân viên</div>
    
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        
        <!-- Hàng 1: Mã NV, Họ tên, Ngày sinh (3 cột) -->
        <div class="form-grid-3">
            <div class="form-group">
                <label>Mã nhân viên <span class="required">(*)</span></label>
                <input asp-for="SMaNV" class="form-control" placeholder="Nhập mã nhân viên (VD: NV004)" required />
            </div>
            <div class="form-group">
                <label>Họ và tên <span class="required">(*)</span></label>
                <input asp-for="STenNV" class="form-control" placeholder="Nhập họ và tên" required />
            </div>
            <div class="form-group">
                <label>Ngày sinh <span class="required">(*)</span></label>
                <input asp-for="DNgaySinh" type="date" class="form-control" required />
            </div>
        </div>

        <!-- Hàng 2: CCCD, Giới tính, Số điện thoại (3 cột) -->
        <div class="form-grid-3">
            <div class="form-group">
                <label>CCCD <span class="required">(*)</span></label>
                <input asp-for="SCCCD" class="form-control" placeholder="Nhập số CCCD (12 số)" required />
            </div>
            <div class="form-group">
                <label>Giới tính <span class="required">(*)</span></label>
                <div class="radio-group">
                    <label class="radio-label">
                        <input type="radio" asp-for="SGioiTinh" value="Nam" checked /> Nam
                    </label>
                    <label class="radio-label">
                        <input type="radio" asp-for="SGioiTinh" value="Nữ" /> Nữ
                    </label>
                    <label class="radio-label">
                        <input type="radio" asp-for="SGioiTinh" value="Khác" /> Khác
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label>Số điện thoại <span class="required">(*)</span></label>
                <input asp-for="SSDT" class="form-control" placeholder="Nhập số điện thoại" required />
            </div>
        </div>

        <!-- Hàng 3: Email, Địa chỉ (2 cột) -->
        <div class="form-grid-2">
            <div class="form-group">
                <label>Email <span class="required">(*)</span></label>
                <input asp-for="SEmail" type="email" class="form-control" placeholder="Nhập email" required />
            </div>
            <div class="form-group">
                <label>Địa chỉ <span class="required">(*)</span></label>
                <input asp-for="SDiaChi" class="form-control" placeholder="Nhập địa chỉ" required />
            </div>
        </div>

        <!-- Hàng 4: Lương cơ bản, Ngày vào làm (2 cột) -->
        <div class="form-grid-2">
            <div class="form-group">
                <label>Lương cơ bản (VNĐ) <span class="required">(*)</span></label>
                <input asp-for="FLuongcb" type="number" step="100000" class="form-control" placeholder="Nhập mức lương cơ bản" required />
            </div>
            <div class="form-group">
                <label>Ngày vào làm <span class="required">(*)</span></label>
                <input asp-for="DNgayVaoLam" type="date" class="form-control" required />
            </div>
        </div>

        <!-- Hàng 5: Phòng ban & Chức vụ (2 cột rộng rãi) -->
        <div class="form-grid-2">
            <div class="form-group">
                <label>Phòng ban <span class="required">(*)</span></label>
                <select asp-for="FK_sMaPB" class="form-select" asp-items="ViewBag.FK_sMaPB" required>
                    <option value="">-- Chọn phòng ban --</option>
                </select>
            </div>
            <div class="form-group">
                <label>Chức vụ <span class="required">(*)</span></label>
                <select asp-for="FK_sMaCV" class="form-select" asp-items="ViewBag.FK_sMaCV" required>
                    <option value="">-- Chọn chức vụ --</option>
                </select>
            </div>
        </div>

        <!-- Nút thao tác -->
        <div class="form-actions">
            <button type="submit" class="btn-primary"><i class="bi bi-plus-lg"></i> Thêm mới</button>
            <button type="reset" class="btn-secondary"><i class="bi bi-arrow-clockwise"></i> Làm mới</button>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/nhanvien.css" />
}