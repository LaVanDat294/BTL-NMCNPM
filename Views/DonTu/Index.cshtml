@model IEnumerable<NMCNPM.Models.DonTu>
@{
    ViewData["Title"] = "Quản lý Đơn từ & Phê duyệt";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-envelope-paper text-warning me-2"></i>Quản lý Đơn từ & Phê duyệt</h2>
        <a asp-action="TaoDon" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Tạo đơn mới</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Nhân viên</th>
                        <th>Loại đơn</th>
                        <th>Ngày gửi</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th>Người duyệt</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.SMaDon</td>
                                <td>@(item.NhanVien?.STenNV ?? item.FK_sMaNV)</td>
                                <td><span class="badge bg-secondary">@item.SLoaiDon</span></td>
                                <td>@(item.DNgayGui.HasValue ? item.DNgayGui.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>@item.SLyDo</td>
                                <td>
                                    @if (item.STrangThai == "Đã duyệt")
                                    {
                                        <span class="badge bg-success">Đã duyệt</span>
                                    }
                                    else if (item.STrangThai == "Từ chối")
                                    {
                                        <span class="badge bg-danger">Từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                    }
                                </td>
                                <td>@(item.SNguoiDuyet ?? "-")</td>
                                <td class="text-center">
                                    @if (item.STrangThai == "Chờ duyệt")
                                    {
                                        <a asp-action="PheDuyet" asp-route-id="@item.SMaDon" class="btn btn-sm btn-outline-success"><i class="bi bi-check-circle"></i> Duyệt đơn</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Đã xử lý</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có đơn từ nào được gửi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
