
@model NMCNPM.Models.DonTu

@{
    ViewData["Title"] = "Tạo đơn từ mới";
}

<div class="page-heading">
    <h2><i class="bi bi-file-earmark-plus"></i> Tạo đơn từ mới</h2>

    <a asp-controller="DonTu" asp-action="Index"
       class="btn btn-outline-secondary px-4 py-2">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="hrm-card">
    <div class="hrm-card-header">
        <i class="bi bi-card-text"></i> Thông tin đơn từ
    </div>

    <div class="hrm-card-body">
        <form asp-controller="DonTu" asp-action="TaoDon" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="sLoaiDon" class="form-label">
                        Loại đơn <span class="text-danger">(*)</span>
                    </label>

                    <select asp-for="sLoaiDon" class="form-select">
                        <option value="">-- Chọn loại đơn --</option>
                        <option value="Nghỉ phép">Nghỉ phép</option>
                        <option value="Đổi ca">Đổi ca</option>
                        <option value="Giải trình">Giải trình</option>
                    </select>

                    <span asp-validation-for="sLoaiDon"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ngày gửi đơn</label>
                    <input type="text" class="form-control"
                           value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")"
                           readonly />
                </div>

                <div class="col-12">
                    <label asp-for="sLyDo" class="form-label">
                        Lý do <span class="text-danger">(*)</span>
                    </label>

                    <textarea asp-for="sLyDo"
                              class="form-control"
                              rows="6"
                              placeholder="Nhập nội dung và lý do gửi đơn..."></textarea>

                    <span asp-validation-for="sLyDo"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-4">
                <button type="submit" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-send"></i> Gửi đơn
                </button>

                <button type="reset"
                        class="btn btn-outline-secondary px-4 py-2">
                    <i class="bi bi-arrow-counterclockwise"></i> Làm mới
                </button>

                <a asp-controller="DonTu" asp-action="Index"
                   class="btn btn-outline-secondary px-4 py-2">
                    Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
