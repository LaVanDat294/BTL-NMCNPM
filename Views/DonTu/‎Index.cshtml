
@model IEnumerable<HRM_Tocotoco.Models.DonTu>

@{
    ViewData["Title"] = "Danh sách đơn từ";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>QUẢN LÝ ĐƠN TỪ</h2>

        <a asp-controller="DonTu"
           asp-action="TaoDon"
           class="btn btn-primary">
            + Tạo đơn mới
        </a>
    </div>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success">
            @TempData["ThongBao"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Danh sách đơn của tôi
        </div>

        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Loại đơn</th>
                        <th>Ngày gửi</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th>Người duyệt</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.sMaDon</td>
                                <td>@item.sLoaiDon</td>
                                <td>
                                    @item.dNgayGui?.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>@item.sLyDo</td>
                                <td>
                                    @if (item.sTrangThai == "Chờ duyệt")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Chờ duyệt
                                        </span>
                                    }
                                    else if (item.sTrangThai == "Đã duyệt")
                                    {
                                        <span class="badge bg-success">
                                            Đã duyệt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Từ chối
                                        </span>
                                    }
                                </td>
                                <td>
                                    @(item.sTenNguoiDuyet ?? "Chưa có")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">
                                Bạn chưa có đơn từ nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>