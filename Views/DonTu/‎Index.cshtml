
@model IEnumerable<NMCNPM.Models.DonTu>

@{
    ViewData["Title"] = "Quản lý đơn từ";
}

<div class="page-heading">
    <h2><i class="bi bi-file-earmark-text"></i> Danh sách đơn từ của tôi</h2>

    <a asp-controller="DonTu" asp-action="TaoDon"
       class="btn btn-primary px-4 py-2">
        <i class="bi bi-plus-lg"></i> Tạo đơn mới
    </a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-info alert-dismissible fade show">
        @TempData["ThongBao"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="hrm-card">
    <div class="hrm-card-header">
        <i class="bi bi-list-ul"></i> Lịch sử gửi đơn
    </div>

    <div class="hrm-card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Mã đơn</th>
                        <th>Loại đơn</th>
                        <th>Ngày gửi</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th>Người duyệt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td><strong>@item.sMaDon</strong></td>
                                <td>@item.sLoaiDon</td>
                                <td>@item.dNgayGui.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.sLyDo</td>
                                <td>
                                    @if (item.sTrangThai == "Đã duyệt")
                                    {
                                        <span class="badge bg-success">Đã duyệt</span>
                                    }
                                    else if (item.sTrangThai == "Từ chối")
                                    {
                                        <span class="badge bg-danger">Từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(item.sTenNguoiDuyet) ? "Chưa có" : item.sTenNguoiDuyet)</td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Bạn chưa gửi đơn từ nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
