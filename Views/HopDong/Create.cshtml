@model NMCNPM.Models.HopDongLaoDong

@{
    ViewData["Title"] = "Tạo hợp đồng lao động mới";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="bi bi-file-earmark-plus-fill me-2"></i>Tạo hợp đồng lao động mới
        </h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 text-center">
            <span class="fw-bold text-secondary">
                <i class="bi bi-info-circle me-1"></i> Thông tin hợp đồng
            </span>
        </div>

        <div class="card-body">
            <form asp-action="ThemMoi" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-md-4">
                    <label asp-for="SMaHD" class="form-label fw-semibold">
                        Mã hợp đồng (<span class="text-danger">*</span>)
                    </label>
                    <input asp-for="SMaHD" class="form-control" placeholder="Nhập mã hợp đồng..." required />
                    <span asp-validation-for="SMaHD" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FK_sMaNV" class="form-label fw-semibold">
                        Nhân viên (<span class="text-danger">*</span>)
                    </label>
                    <select asp-for="FK_sMaNV" class="form-select"
                            asp-items="ViewBag.DanhSachNhanVien" required>
                        <option value="">-- Chọn nhân viên --</option>
                    </select>
                    <span asp-validation-for="FK_sMaNV" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="SLoaiHD" class="form-label fw-semibold">
                        Loại hợp đồng (<span class="text-danger">*</span>)
                    </label>
                    <input asp-for="SLoaiHD" class="form-control"
                           placeholder="Nhập loại hợp đồng..." required />
                    <span asp-validation-for="SLoaiHD" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DNgayKy" class="form-label fw-semibold">
                        Ngày ký hợp đồng (<span class="text-danger">*</span>)
                    </label>
                    <input asp-for="DNgayKy" type="date" class="form-control" required />
                    <span asp-validation-for="DNgayKy" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DNgayHetHan" class="form-label fw-semibold">
                        Ngày hết hạn
                    </label>
                    <input asp-for="DNgayHetHan" type="date" class="form-control" />
                    <span asp-validation-for="DNgayHetHan" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="alert alert-info py-2 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Trạng thái ban đầu của hợp đồng sẽ là
                        <strong>Còn hiệu lực</strong>.
                    </div>
                </div>

                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-primary px-5 py-2 me-2">
                        <i class="bi bi-plus-circle me-1"></i> Thêm mới
                    </button>
                    <button type="reset" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
