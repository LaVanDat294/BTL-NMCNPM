@model NMCNPM.Controllers.HopDongChiTietVM

@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    Layout = "~/Views/HopDong/_LayoutHopDong.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="text-muted small mb-2">
            Quản lý hợp đồng / Danh sách hợp đồng / Chi tiết
        </div>
        <h3 class="fw-bold text-primary mb-0">Chi tiết hợp đồng lao động</h3>
    </div>
    <a asp-controller="HopDong" asp-action="Index"
       class="btn btn-outline-primary">
        &lt; Quay lại
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header text-center fw-bold text-primary bg-primary bg-opacity-10">
        Thông tin hợp đồng
    </div>

    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Mã hợp đồng</label>
                <input value="@Model.SMaHD" class="form-control bg-light" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Loại hợp đồng</label>
                <input value="@Model.LoaiHD" class="form-control bg-light" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Mã nhân viên</label>
                <input value="@Model.MaNV" class="form-control bg-light" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Họ và tên nhân viên</label>
                <input value="@Model.TenNV" class="form-control bg-light" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Ngày ký hợp đồng</label>
                <input value="@Model.NgayKy.ToString("dd/MM/yyyy")"
                       class="form-control bg-light" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Ngày hết hạn</label>
                <input value="@(Model.NgayHetHan?.ToString("dd/MM/yyyy") ?? "Không xác định")"
                       class="form-control bg-light" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Lương cơ bản (VNĐ)</label>
                <input value="@Model.LuongCoBan.ToString("N0")"
                       class="form-control bg-light" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Trạng thái</label>
                <input value="@Model.TrangThai"
                       class="form-control bg-light" readonly />
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-controller="HopDong" asp-action="Index"
               class="btn btn-outline-secondary px-4">
                Quay lại danh sách
            </a>

            @if (Model.TrangThai != "Đã hủy")
            {
                <a asp-controller="HopDong"
                   asp-action="Edit"
                   asp-route-ma="@Model.SMaHD"
                   class="btn btn-primary px-4">
                    Chỉnh sửa
                </a>
            }
        </div>
    </div>
</div>
