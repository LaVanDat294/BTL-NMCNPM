
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhân sự</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f1f5fc;
            font-family: Arial, sans-serif;
            color: #26364a;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 250px;
            background: #174675;
            color: white;
            padding: 20px 14px;
        }

        .sidebar-title {
            font-size: 17px;
            font-weight: bold;
            padding: 8px;
            margin-bottom: 25px;
        }

        .sidebar a {
            display: block;
            color: #dce9f8;
            text-decoration: none;
            padding: 12px 14px;
            margin-bottom: 5px;
            border-radius: 7px;
            font-size: 14px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #2476d2;
            color: white;
        }

        .sidebar .sub-menu {
            padding-left: 25px;
            font-size: 13px;
        }

        .main-content {
            margin-left: 250px;
            min-height: 100vh;
        }

        .topbar {
            height: 52px;
            background: white;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 25px;
            border-bottom: 1px solid #e1e7ef;
        }

        .page-content {
            padding: 25px;
        }

        .breadcrumb-custom {
            font-size: 13px;
            color: #718096;
            margin-bottom: 15px;
        }

        .page-title {
            color: #2476d2;
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 190px;
            }

            .main-content {
                margin-left: 190px;
            }

            .page-content {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-title">👥 HỆ THỐNG QUẢN LÝ NHÂN SỰ</div>

        <a href="#">⌂ &nbsp; Trang chủ</a>

        <a asp-controller="HopDong" asp-action="Index" class="active">
            📁 &nbsp; Quản lý hợp đồng
        </a>

        <a asp-controller="HopDong" asp-action="Index" class="sub-menu">
            ☰ &nbsp; Danh sách hợp đồng
        </a>

        <a asp-controller="HopDong" asp-action="ThemMoi" class="sub-menu">
            + &nbsp; Tạo hợp đồng mới
        </a>

        <a href="#">👥 &nbsp; Quản lý nhân viên</a>
        <a href="#">🏢 &nbsp; Quản lý phòng ban</a>
        <a href="#">💼 &nbsp; Quản lý chức vụ</a>
        <a href="#">◷ &nbsp; Chấm công</a>
        <a href="#">＄ &nbsp; Lương</a>
        <a href="#">▤ &nbsp; Báo cáo</a>
        <a href="#">⚙ &nbsp; Cài đặt</a>
    </aside>

    <div class="main-content">
        <header class="topbar">
            <strong>👤 Admin ▾</strong>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
