@model IEnumerable<NMCNPM.Models.HopDongLaoDong>

@{
    ViewData["Title"] = "Quản lý Hợp đồng lao động";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-file-earmark-text text-info me-2"></i>Quản lý Hợp đồng lao động</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Thêm hợp đồng mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Nhân viên</th>
                        <th>Loại hợp đồng</th>
                        <th>Ngày ký</th>
                        <th>Ngày hết hạn</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var isExpiringSoon = item.DNgayHetHan.HasValue && (item.DNgayHetHan.Value - DateTime.Now).TotalDays <= 30 && (item.DNgayHetHan.Value - DateTime.Now).TotalDays >= 0;
                            var isExpired = item.DNgayHetHan.HasValue && item.DNgayHetHan.Value < DateTime.Now;

                            <tr>
                                <td class="fw-bold">@item.SMaHD</td>
                                <td>@(item.NhanVien?.STenNV ?? item.FK_sMaNV)</td>
                                <td><span class="badge bg-secondary">@item.SLoaiHD</span></td>
                                <td>@item.DNgayKy.ToString("dd/MM/yyyy")</td>
                                <td>@(item.DNgayHetHan.HasValue ? item.DNgayHetHan.Value.ToString("dd/MM/yyyy") : "Không thời hạn")</td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-danger">Hết hạn</span>
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle"></i> Sắp hết hạn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@(item.STrangThai ?? "Đang hiệu lực")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.SMaHD" class="btn btn-sm btn-info text-white" title="Xem chi tiết"><i class="bi bi-eye"></i> Xem</a>
                                    <a asp-action="Edit" asp-route-id="@item.SMaHD" class="btn btn-sm btn-warning" title="Chỉnh sửa"><i class="bi bi-pencil"></i> Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@item.SMaHD" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy hợp đồng này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Hủy hợp đồng"><i class="bi bi-trash"></i> Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có hợp đồng lao động nào được ghi nhận.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>