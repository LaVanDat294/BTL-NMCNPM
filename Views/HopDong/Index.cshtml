@model NMCNPM.Controllers.HopDongDanhSachTrangVM

@{
    Layout = "~/Views/HopDong/_LayoutHopDong.cshtml";
    ViewData["Title"] = "Danh sách hợp đồng";
}

<div class="breadcrumb-custom">
    Quản lý hợp đồng / Danh sách hợp đồng
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Danh sách hợp đồng lao động</h2>
    <a asp-controller="HopDong" asp-action="ThemMoi"
       class="btn btn-primary">
        + Tạo hợp đồng mới
    </a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">
        @TempData["Loi"]
    </div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-primary bg-opacity-10 fw-bold text-primary">
        Bộ lọc
    </div>

    <div class="card-body">
        <form method="get" asp-controller="HopDong" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Mã hợp đồng / Mã NV / Tên nhân viên
                    </label>
                    <input type="text" name="tuKhoa"
                           value="@Model.TuKhoa"
                           class="form-control"
                           placeholder="Nhập từ khóa..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Còn hiệu lực"
                                selected="@(Model.TrangThai == "Còn hiệu lực")">
                            Còn hiệu lực
                        </option>
                        <option value="Đã hủy"
                                selected="@(Model.TrangThai == "Đã hủy")">
                            Đã hủy
                        </option>
                        <option value="Hết hạn"
                                selected="@(Model.TrangThai == "Hết hạn")">
                            Hết hạn
                        </option>
                    </select>
                </div>

                <div class="col-md-5">
                    <button type="submit" class="btn btn-primary">
                        Tìm kiếm
                    </button>
                    <a asp-controller="HopDong" asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Làm mới
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10 fw-bold text-primary">
        Bảng hợp đồng lao động
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle text-center">
                <thead class="table-primary">
                    <tr>
                        <th>STT</th>
                        <th>Mã hợp đồng</th>
                        <th>Mã NV</th>
                        <th>Họ và tên</th>
                        <th>Ngày ký</th>
                        <th>Lương cơ bản (VNĐ)</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.DanhSach != null && Model.DanhSach.Any())
                    {
                        @for (int i = 0; i < Model.DanhSach.Count; i++)
                        {
                            var hd = Model.DanhSach[i];

                            <tr>
                                <td>@((Model.TrangHienTai - 1) * 10 + i + 1)</td>
                                <td class="fw-semibold">@hd.SMaHD</td>
                                <td>@hd.MaNV</td>
                                <td>@hd.TenNV</td>
                                <td>@hd.NgayKy.ToString("dd/MM/yyyy")</td>
                                <td>@hd.LuongCoBan.ToString("N0")</td>
                                <td>
                                    @if (hd.TrangThai == "Còn hiệu lực")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            Còn hiệu lực
                                        </span>
                                    }
                                    else if (hd.TrangThai == "Đã hủy")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">
                                            Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            @hd.TrangThai
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-controller="HopDong"
                                           asp-action="ChiTiet"
                                           asp-route-ma="@hd.SMaHD"
                                           class="btn btn-sm btn-outline-primary">
                                            Xem
                                        </a>

                                        @if (hd.TrangThai != "Đã hủy")
                                        {
                                            <a asp-controller="HopDong"
                                               asp-action="ChinhSua"
                                               asp-route-ma="@hd.SMaHD"
                                               class="btn btn-sm btn-outline-primary">
                                                Sửa
                                            </a>

                                            <form asp-controller="HopDong"
                                                  asp-action="Xoa"
                                                  asp-route-ma="@hd.SMaHD"
                                                  method="post"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy hợp đồng này không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Xóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-muted py-4">
                                Không có dữ liệu hợp đồng.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="text-muted small">
                Tổng số: @Model.TongSoHopDong hợp đồng
            </div>

            @if (Model.TongSoTrang > 1)
            {
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.TrangHienTai <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.TrangHienTai - 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThai="@Model.TrangThai">
                                Trước
                            </a>
                        </li>

                        @for (int p = 1; p <= Model.TongSoTrang; p++)
                        {
                            <li class="page-item @(p == Model.TrangHienTai ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThai="@Model.TrangThai">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.TrangHienTai >= Model.TongSoTrang ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.TrangHienTai + 1)"
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThai="@Model.TrangThai">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
