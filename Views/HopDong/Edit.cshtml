@model NMCNPM.Models.HopDongLaoDong

@{
    ViewData["Title"] = "Sửa thông tin hợp đồng";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="bi bi-pencil-square me-2"></i>Sửa thông tin hợp đồng lao động
        </h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-chevron-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary bg-opacity-10 py-3">
            <span class="fw-bold text-primary">
                <i class="bi bi-info-circle me-1"></i> Thông tin hợp đồng
            </span>
        </div>

        <div class="card-body">
            <form asp-action="Sua" asp-route-id="@Model.SMaHD" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="SMaHD" />

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Mã hợp đồng</label>
                    <input type="text" class="form-control bg-light text-dark fw-bold"
                           value="@Model.SMaHD (Khóa chỉ đọc)" disabled />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Nhân viên</label>
                    <input type="text" class="form-control bg-light text-dark"
                           value="@Model.FK_sMaNV - @ViewBag.TenNhanVien" disabled />
                </div>

                <div class="col-md-4">
                    <label asp-for="SLoaiHD" class="form-label fw-semibold">
                        Loại hợp đồng (<span class="text-danger">*</span>)
                    </label>
                    <input asp-for="SLoaiHD" class="form-control"
                           placeholder="Nhập loại hợp đồng..." required />
                    <span asp-validation-for="SLoaiHD" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DNgayKy" class="form-label fw-semibold">
                        Ngày ký hợp đồng (<span class="text-danger">*</span>)
                    </label>
                    <input asp-for="DNgayKy" type="date" class="form-control" required />
                    <span asp-validation-for="DNgayKy" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DNgayHetHan" class="form-label fw-semibold">
                        Ngày hết hạn
                    </label>
                    <input asp-for="DNgayHetHan" type="date" class="form-control" />
                    <span asp-validation-for="DNgayHetHan" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="alert alert-info py-2 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Trạng thái hiện tại:
                        <strong>@Model.STrangThai</strong>
                    </div>
                </div>

                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-primary px-5 py-2 me-2">
                        <i class="bi bi-check-circle me-1"></i> Cập nhật
                    </button>
                    <button type="reset" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
