@{
    ViewData["Title"] = "Trang chủ - QLNS Tocotoco";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="bg-white p-4 rounded border mb-4">
        <h3 class="fw-bold text-primary mb-2">HỆ THỐNG QUẢN LÝ NHÂN SỰ TOCOTOCO</h3>
        <p class="text-muted mb-0">Hệ thống hỗ trợ quản lý hồ sơ nhân viên, theo dõi lịch làm việc, chấm công và tính lương cho chuỗi cửa hàng.</p>
    </div>

    <!-- Stats Cards (Removed shadows) -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="card border">
                <div class="card-body">
                    <h5 class="card-title text-muted">Nhân viên</h5>
                    <p class="display-6 fw-bold text-primary mb-0">@ViewBag.TotalNhanVien</p>
                </div>
                <div class="card-footer bg-light border-top">
                    <a asp-controller="NhanVien" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Chi tiết</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border">
                <div class="card-body">
                    <h5 class="card-title text-muted">Phòng ban</h5>
                    <p class="display-6 fw-bold text-success mb-0">@ViewBag.TotalPhongBan</p>
                </div>
                <div class="card-footer bg-light border-top">
                    <a asp-controller="PhongBan" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Chi tiết</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border">
                <div class="card-body">
                    <h5 class="card-title text-muted">Chức vụ</h5>
                    <p class="display-6 fw-bold text-info mb-0">@ViewBag.TotalChucVu</p>
                </div>
                <div class="card-footer bg-light border-top">
                    <a asp-controller="ChucVu" asp-action="Index" class="btn btn-sm btn-outline-info w-100">Chi tiết</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border">
                <div class="card-body">
                    <h5 class="card-title text-muted">Hợp đồng</h5>
                    <p class="display-6 fw-bold text-warning mb-0">@ViewBag.TotalHopDong</p>
                </div>
                <div class="card-footer bg-light border-top">
                    <a asp-controller="HopDong" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">Chi tiết</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Shortcut Menu -->
    <div class="card border mb-4">
        <div class="card-header bg-light fw-bold">
            <i class="bi bi-grid-fill text-secondary me-2"></i>Chức năng nhanh
        </div>
        <div class="card-body">
            <div class="row g-2 text-center">
                <div class="col-md-3">
                    <a asp-controller="NhanVien" asp-action="Create" class="btn btn-light border w-100 py-3">
                        <i class="bi bi-person-plus d-block mb-1 fs-4"></i>
                        Thêm nhân viên
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-controller="ChamCong" asp-action="Create" class="btn btn-light border w-100 py-3">
                        <i class="bi bi-clock d-block mb-1 fs-4"></i>
                        Chấm công
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-controller="Luong" asp-action="Index" class="btn btn-light border w-100 py-3">
                        <i class="bi bi-cash-stack d-block mb-1 fs-4"></i>
                        Xem bảng lương
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-controller="BaoCao" asp-action="Index" class="btn btn-light border w-100 py-3">
                        <i class="bi bi-bar-chart d-block mb-1 fs-4"></i>
                        Xem báo cáo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
