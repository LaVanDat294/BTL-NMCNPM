@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-gear-fill me-2"></i>Cài đặt hệ thống</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 border-end">
                    <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start mb-2" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button" role="tab"><i class="bi bi-person-gear me-2"></i>Tài khoản cá nhân</button>
                        <button class="nav-link text-start mb-2" id="v-pills-general-tab" data-bs-toggle="pill" data-bs-target="#v-pills-general" type="button" role="tab"><i class="bi bi-sliders me-2"></i>Cấu hình chung</button>
                        <button class="nav-link text-start mb-2" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab"><i class="bi bi-shield-lock me-2"></i>Bảo mật</button>
                        <button class="nav-link text-start mb-2" id="v-pills-notifications-tab" data-bs-toggle="pill" data-bs-target="#v-pills-notifications" type="button" role="tab"><i class="bi bi-bell-gear me-2"></i>Thông báo</button>
                    </div>
                </div>
                <div class="col-md-9 p-4">
                    <div class="tab-content" id="v-pills-tabContent">
                        <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel">
                            <h5 class="mb-4">Thông tin tài khoản</h5>
                            <form>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Tên hiển thị</label>
                                        <input type="text" class="form-control" value="Admin Quản trị">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email</label>
                                        <input type="email" class="form-control" value="admin@tocotoco.com" disabled>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Vai trò</label>
                                    <input type="text" class="form-control" value="Quản trị viên hệ thống" disabled>
                                </div>
                                <button type="button" class="btn btn-primary mt-2">Cập nhật thông tin</button>
                            </form>
                        </div>
                        <div class="tab-pane fade" id="v-pills-general" role="tabpanel">
                            <h5 class="mb-4">Cấu hình hệ thống</h5>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-switch" type="checkbox" id="darkMode" checked disabled>
                                <label class="form-check-label" for="darkMode">Chế độ sáng/tối (Tự động)</label>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Ngôn ngữ hiển thị</label>
                                <select class="form-select w-50">
                                    <option selected>Tiếng Việt</option>
                                    <option>English</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 p-3 bg-white rounded shadow-sm">
        <p class="mb-0 text-muted small"><i class="bi bi-info-circle me-2"></i>Phiên bản ứng dụng: v1.0.0 (Bản thử nghiệm Đồ án NMCNPM)</p>
    </div>
</div>
