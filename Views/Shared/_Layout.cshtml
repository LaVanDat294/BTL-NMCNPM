
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool isLuong = string.Equals(
        currentController, "Luong",
        StringComparison.OrdinalIgnoreCase
    );

    bool isChotKy = isLuong && currentAction == "ChotKy";
    bool isBangLuong = isLuong && currentAction == "BangLuong";
    bool isQuanLyTinhLuong = isLuong &&
        (currentAction == "Index" ||
         currentAction == "ChotKy" ||
         currentAction == "DieuChinh");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Quản Lý Nhân Sự Tocotoco</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Custom Style -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background-color: #f4f6f9;
            font-size: 0.95rem;
            margin: 0;
        }

        /* SIDEBAR */

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 0;
            background-color: #0d3b66;
            width: 260px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar .brand-box {
            padding: 20px 15px;
            color: #fff;
            background-color: #092c4a;
            font-weight: bold;
            font-size: 1.1rem;
            min-height: 70px;
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.9);
            padding: 12px 16px;
            margin: 2px 8px;
            border-radius: 8px;
            font-size: 1rem;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #fff;
            background-color: #2169d5;
        }

        .sidebar .nav-link .bi {
            margin-right: 10px;
            font-size: 1.15rem;
        }

        /* MENU LƯƠNG */

        .sidebar .menu-toggle {
            justify-content: space-between;
            cursor: pointer;
        }

        .sidebar .menu-toggle .menu-title {
            display: flex;
            align-items: center;
        }

        .sidebar .menu-toggle .chevron {
            margin-right: 0;
            transition: transform 0.2s ease;
        }

        .sidebar .menu-toggle[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }

        .sidebar .submenu {
            padding-left: 12px;
        }

        .sidebar .submenu .nav-link {
            padding-left: 18px;
            font-size: 0.95rem;
        }

        .sidebar .submenu .nav-link .bi {
            font-size: 0.9rem;
        }

        .sidebar .menu-toggle.active {
            background-color: #2169d5;
            color: #fff;
        }

        /* MAIN CONTENT */

        .main-content {
            margin-left: 260px;
            padding: 20px;
            min-height: 100vh;
        }

        .top-navbar {
            background-color: #fff;
            padding: 12px 20px;
            margin-bottom: 24px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
        }

        .top-navbar .breadcrumb-link {
            color: #6c757d;
            text-decoration: none;
        }

        .top-navbar .breadcrumb-link:hover {
            color: #2169d5;
        }

        /* RESPONSIVE */

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                position: relative;
                height: auto;
                max-height: none;
            }

            .main-content {
                margin-left: 0;
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar d-flex flex-column flex-shrink-0">

        <!-- Logo -->
        <div class="brand-box d-flex align-items-center">
            <i class="bi bi-people-fill fs-4 me-2"></i>
            <span>QLNS TOCOTOCO</span>
        </div>

        <ul class="nav flex-column mb-auto mt-2">

            <!-- Trang chủ -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-house-door"></i>
                    Trang chủ
                </a>
            </li>

            <!-- Nhân viên -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "NhanVien" ? "active" : "")"
                   asp-controller="NhanVien"
                   asp-action="Index">
                    <i class="bi bi-person"></i>
                    Quản lý nhân viên
                </a>
            </li>

            <!-- Phòng ban -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "PhongBan" ? "active" : "")"
                   asp-controller="PhongBan"
                   asp-action="Index">
                    <i class="bi bi-building"></i>
                    Quản lý phòng ban
                </a>
            </li>

            <!-- Chức vụ -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "ChucVu" ? "active" : "")"
                   asp-controller="ChucVu"
                   asp-action="Index">
                    <i class="bi bi-briefcase"></i>
                    Quản lý chức vụ
                </a>
            </li>

            <!-- Chấm công -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "ChamCong" ? "active" : "")"
                   asp-controller="ChamCong"
                   asp-action="Index">
                    <i class="bi bi-clock"></i>
                    Chấm công
                </a>
            </li>

            <!-- LƯƠNG -->
            <li class="nav-item">

                <a class="nav-link menu-toggle @(isLuong ? "active" : "")"
                   data-bs-toggle="collapse"
                   href="#menuLuong"
                   role="button"
                   aria-expanded="@(isLuong ? "true" : "false")"
                   aria-controls="menuLuong">

                    <span class="menu-title">
                        <i class="bi bi-currency-dollar"></i>
                        Lương
                    </span>

                    <i class="bi bi-chevron-down chevron"></i>
                </a>

                <!-- Tự mở khi đang ở LuongController -->
                <div class="collapse @(isLuong ? "show" : "")"
                     id="menuLuong">

                    <ul class="nav flex-column submenu">

                        <!-- Quản lý tính lương: /Luong -->
                        <li class="nav-item">
                            <a class="nav-link @(isQuanLyTinhLuong ? "active" : "")"
                               asp-controller="Luong"
                               asp-action="Index">

                                <i class="bi bi-dot"></i>
                                Quản lý tính lương
                            </a>
                        </li>

                        <!-- Xem bảng lương: /Luong/BangLuong -->
                        <li class="nav-item">
                            <a class="nav-link @(isBangLuong ? "active" : "")"
                               asp-controller="Luong"
                               asp-action="BangLuong">

                                <i class="bi bi-dot"></i>
                                Xem bảng lương
                            </a>
                        </li>

                    </ul>
                </div>
            </li>

            <!-- Hợp đồng -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "HopDong" ? "active" : "")"
                   asp-controller="HopDong"
                   asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i>
                    Hợp đồng
                </a>
            </li>

            <!-- Đơn từ -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "DonTu" ? "active" : "")"
                   asp-controller="DonTu"
                   asp-action="Index">
                    <i class="bi bi-envelope"></i>
                    Đơn từ
                </a>
            </li>

            <!-- Báo cáo -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "BaoCao" ? "active" : "")"
                   asp-controller="BaoCao"
                   asp-action="Index">
                    <i class="bi bi-bar-chart"></i>
                    Báo cáo
                </a>
            </li>

            <!-- Đổi mật khẩu -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "Account" && currentAction == "ChangePassword" ? "active" : "")"
                   asp-controller="Account"
                   asp-action="ChangePassword">
                    <i class="bi bi-key"></i>
                    Đổi mật khẩu
                </a>
            </li>

            <!-- Cài đặt -->
            <li class="nav-item">
                <a class="nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Privacy">
                    <i class="bi bi-gear"></i>
                    Cài đặt
                </a>
            </li>

        </ul>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="p-3 border-top border-light border-opacity-10 mt-auto">
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        }
    </div>

    <!-- MAIN CONTENT -->

    <div class="main-content">

        <nav class="navbar navbar-expand navbar-light top-navbar">

            <div class="container-fluid p-0">

                <span class="navbar-text text-muted small">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="breadcrumb-link">
                        Trang chủ
                    </a>
                    / Hệ thống
                </span>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-bold d-flex align-items-center"
                               href="#"
                               id="navbarUserDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-person-circle fs-5 me-1 text-primary"></i>
                                <span>@(User.Identity.Name)</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="navbarUserDropdown">
                                <li class="px-3 py-2 border-bottom">
                                    <small class="text-muted d-block">Đang đăng nhập với</small>
                                    <span class="fw-bold text-dark">@(User.Identity.Name)</span>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2 text-warning"></i> Đổi mật khẩu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </nav>

        <!-- NỘI DUNG TRANG -->
        <main role="main">
            @RenderBody()
        </main>

    </div>

    <!-- JAVASCRIPT -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
