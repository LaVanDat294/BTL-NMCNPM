<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Nhân Sự Tocotoco</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #f4f6f9;
            font-size: 0.95rem;
        }
        /* Sidebar bên trái */
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 0;
            background-color: #0d3b66;
            width: 260px;
        }
        .sidebar .brand-box {
            padding: 20px 15px;
            color: #fff;
            background-color: #092c4a;
            font-weight: bold;
            font-size: 1.1rem;
        }
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            border-radius: 0;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #fff;
            background-color: #1d4ed8;
        }
        .sidebar .nav-link .bi {
            margin-right: 10px;
        }
        /* Khu vực nội dung chính */
        .main-content {
            margin-left: 260px;
            padding: 20px;
        }
        @@media (max-width: 768px) {
            .sidebar { width: 100%; position: relative; height: auto; }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR BÊN TRÁI -->
    <div class="sidebar d-flex flex-column flex-shrink-0">
        <div class="brand-box d-flex align-items-center">
            <i class="bi bi-people-fill fs-4 me-2"></i>
            <span>QLNS TOCOTOCO</span>
        </div>
        <ul class="nav flex-column mb-auto mt-2">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i>Trang chủ</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="NhanVien" asp-action="Index"><i class="bi bi-person-badge"></i>Nhân viên</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="PhongBan" asp-action="Index"><i class="bi bi-building"></i>Phòng ban</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="ChucVu" asp-action="Index"><i class="bi bi-briefcase"></i>Chức vụ</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="ChamCong" asp-action="Index"><i class="bi bi-clock-history"></i>Chấm công</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Luong" asp-action="Index"><i class="bi bi-cash-stack"></i>Lương</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="HopDong" asp-action="Index"><i class="bi bi-file-earmark-text"></i>Hợp đồng</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="DonTu" asp-action="Index"><i class="bi bi-envelope"></i>Đơn từ</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="BaoCao" asp-action="Index"><i class="bi bi-bar-chart"></i>Báo cáo</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Privacy"><i class="bi bi-gear"></i>Cài đặt</a>
            </li>
        </ul>
    </div>

    <!-- NAVBAR PHÍA TRÊN & NỘI DUNG -->
    <div class="main-content">
        <nav class="navbar navbar-expand navbar-light bg-white px-3 py-2 mb-4 border-bottom rounded">
            <div class="container-fluid">
                <span class="navbar-text text-muted small">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a> / Hệ thống
                </span>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-3 text-dark fw-bold">
                        <i class="bi bi-person-circle me-1"></i> Admin
                    </li>
                </ul>
            </div>
        </nav>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
