@model NMCNPM.Models.ChucVu
@{
    ViewData["Title"] = "Sửa Chức vụ";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Cập nhật Chức vụ</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="SMaCV" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mã Chức vụ</label>
                    <input class="form-control bg-light" value="@Model.SMaCV" disabled />
                </div>

                <div class="mb-3">
                    <label asp-for="STenCV" class="form-label fw-semibold">Tên Chức vụ <span class="text-danger">*</span></label>
                    <input asp-for="STenCV" class="form-control" required />
                    <span asp-validation-for="STenCV" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FPhuCap" class="form-label fw-semibold">Phụ cấp (VNĐ)</label>
                    <input asp-for="FPhuCap" type="number" step="1000" class="form-control" />
                    <span asp-validation-for="FPhuCap" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>