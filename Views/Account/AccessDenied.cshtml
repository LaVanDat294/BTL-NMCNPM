@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 mx-auto p-4" style="max-width: 500px; border-radius: 16px;">
        <div class="text-danger mb-3">
            <i class="fa-solid fa-triangle-exclamation" style="font-size: 60px;"></i>
        </div>
        <h2 class="fw-bold text-danger">Truy cập bị từ chối</h2>
        <p class="text-muted">Bạn không có quyền truy cập vào chức năng hoặc trang này.</p>
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
                <i class="fa-solid fa-house me-1"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>
